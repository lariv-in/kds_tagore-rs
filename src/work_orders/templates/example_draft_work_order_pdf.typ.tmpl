{# Minijinja template: the rendered output must be valid Typst markup.
   Context (PascalCase) for a draft work order PDF:
     ID, OrderNumber, CustomerId, CreatedAt, Duration,
     Customer { ID, Name, Address, GSTIN, PAN, Phone, Email, Website },
     MaterialLines [ { ID, ComponentId, Component, VariablesDisplay, Taxes, PreTax, FinalCost } ],
     MachineLines  [ { ID, MachineId, Machine, VariablesDisplay, Taxes, PreTax, LineTotal } ],
     TotalAmount (string).
   Functions: num2words, num2wordsAnd, num2wordsRupees, totalAmountWords. #}
#set page(paper: "a4", margin: 1.2cm)
#set text(font: "Liberation Sans", size: 9pt)
#set table(stroke: 0.4pt, inset: 5pt)

#let fmt-num(n) = {
  let v = calc.round(n, digits: 2)
  let s = str(v)
  let parts = s.split(".")
  let whole = parts.at(0)
  let frac = if parts.len() > 1 {
    let f = parts.at(1)
    if f.len() == 1 { "." + f + "0" } else { "." + f }
  } else { ".00" }
  let grouped = {
    let chars = whole.clusters().rev()
    let out = ()
    for (i, c) in chars.enumerate() {
      out = (c,) + out
      if calc.rem(i + 1, 3) == 0 and i + 1 < chars.len() {
        out = (",",) + out
      }
    }
    out.join()
  }
  [#grouped#frac]
}

#let inr(n) = [₹ #fmt-num(n)]

#let material-lines = (
{% for line in MaterialLines %}
  (component: [{{ line.Component }}], vars: [{{ line.VariablesDisplay }}], taxes: [{{ line.Taxes }}], pretax: float(str({{ line.PreTax }})), amount: float(str({{ line.FinalCost }}))),
{% endfor %}
)

#let machine-lines = (
{% for line in MachineLines %}
  (machine: [{{ line.Machine }}], vars: [{{ line.VariablesDisplay }}], taxes: [{{ line.Taxes }}], pretax: float(str({{ line.PreTax }})), amount: float(str({{ line.LineTotal }}))),
{% endfor %}
)

#let grand = float(str({{ TotalAmount }}))

#align(center)[
  *DRAFT WORK ORDER*
]
#v(0.4em)

#table(
  columns: (1fr, 1fr),
  [
    *Bill To* \
    {% if Customer.Name %}*{{ Customer.Name }}* \ {% endif %}
    {% if Customer.Address %}{{ Customer.Address }} \ {% endif %}
    {% if Customer.GSTIN %}GSTIN: {{ Customer.GSTIN }} \ {% endif %}
    {% if Customer.PAN %}PAN: {{ Customer.PAN }}{% endif %}
  ],
  [
    *Order No.:* {% if OrderNumber %}{{ OrderNumber }}{% else %}Draft \#{{ ID }}{% endif %} \
    *Date:* {{ CreatedAt }} \
    *Duration:* {{ Duration }} \
    *Customer ID:* {{ CustomerId }}
  ],
)

#v(0.5em)

{% if MaterialLines %}
*Material Lines*

#table(
  columns: (0.35fr, 1.4fr, 1.8fr, 1fr, 0.9fr, 0.95fr),
  align: (center, left, left, left, right, right),
  [*Sl*], [*Component*], [*Variables*], [*Taxes*], [*Pre-tax*], [*Amount*],
  ..material-lines.enumerate().map(((i, ln)) => (
    str(i + 1),
    ln.component,
    ln.vars,
    ln.taxes,
    inr(ln.pretax),
    inr(ln.amount),
  )).flatten(),
)
#v(0.5em)
{% endif %}

{% if MachineLines %}
*Machine Lines*

#table(
  columns: (0.35fr, 1.6fr, 1.8fr, 1fr, 0.9fr, 0.95fr),
  align: (center, left, left, left, right, right),
  [*Sl*], [*Machine*], [*Variables*], [*Taxes*], [*Pre-tax*], [*Amount*],
  ..machine-lines.enumerate().map(((i, ln)) => (
    str(i + 1),
    ln.machine,
    ln.vars,
    ln.taxes,
    inr(ln.pretax),
    inr(ln.amount),
  )).flatten(),
)
#v(0.5em)
{% endif %}

#grid(
  columns: (1.4fr, 1fr),
  column-gutter: 1em,
  align: (left + horizon, right + horizon),
  [
    *Amount (in words)* \
    {{ totalAmountWords() }}
  ],
  table(
    columns: (1fr, auto),
    align: (left, right),
    [*Total Cost*], [*#inr(grand)*],
  ),
)
